# Local alternative: config/environment.112.local.json (chmod 600, Git ignored).
# Configure exactly one complete source. Never split the three values across sources.

FXIAOKE_ONLINE_ENTERPRISE_ACCOUNT=
FXIAOKE_ONLINE_USERNAME=
FXIAOKE_ONLINE_PASSWORD=

