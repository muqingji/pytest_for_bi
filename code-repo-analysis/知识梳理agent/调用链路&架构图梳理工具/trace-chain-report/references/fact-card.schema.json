{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceFactCard",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "trace_id",
    "title",
    "nodes",
    "gaps",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "trace-fact-card-v1"
    },
    "mode": {
      "enum": [
        "knowledge",
        "live"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 8
    },
    "title": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "entry_time": {
      "type": "string"
    },
    "identity": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "service",
          "entry",
          "method",
          "flow",
          "downstream",
          "timing",
          "evidence",
          "label",
          "row",
          "title_zh",
          "detail",
          "layer"
        ],
        "properties": {
          "label": {
            "enum": [
              "已观测",
              "代码映射",
              "推断",
              "未取证"
            ]
          },
          "row": {
            "type": "integer",
            "minimum": 0
          },
          "layer": {
            "enum": [
              "display",
              "gateway",
              "service",
              "data",
              "offpath"
            ]
          },
          "source": {
            "type": "object",
            "required": [
              "repo",
              "file",
              "symbol",
              "declaration_file",
              "calls"
            ],
            "properties": {
              "repo": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "description": "方法体文件，不能写成只有签名的接口文件"
              },
              "symbol": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "declaration_file": {
                "type": "string"
              },
              "declaration_line": {
                "type": "integer"
              },
              "calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "symbol",
                    "file",
                    "line"
                  ],
                  "properties": {
                    "symbol": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string",
                      "description": "必须等于 source.file"
                    },
                    "line": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
