  "conventions": {
    "task_date": "不在 Fixture 写死，由请求体传入；任务按 (user_id, task_date) 唯一命中",
    "deadline": "相对表达 {relative_to: now, offset_minutes: N}，避免随运行日期失效；offset 为负表示已过期",
    "timezone": "用户本地时区，提醒时间与免打扰都按该时区计算",
    "quiet_hours": "[开始, 结束] 本地 HH:mm，可跨午夜；缺省用默认值 21:30-07:00",
    "behavior.complete_days_7d": "最近 7 天完成全部必做任务的天数，用于自驱型判定（>=5 天）",
    "behavior.reminder_attributed_complete_days_7d": "最近 7 天收到提醒后完成的天数，自驱型需 <=1 天",
    "usage.push_sent_count": "当天已发送的系统主动 Push 次数，用于频控；SNOOZE 用量独立计量"
  },
  "defaults": {
    "preference": {
      "reminder_enabled": true,
      "push_enabled": true,
      "quiet_hours": ["21:30", "07:00"],
      "daily_push_cap": 1,
      "timezone": "UTC"
    },
    "usage": {
      "push_sent_count": 0,
      "snooze_sent_count": 0
    }
  },
