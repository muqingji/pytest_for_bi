{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug reminder-service (FR-001 被动型用户)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/reminder-service",
      "args": [
        "-user", "user-passive",
        "-task-date", "2026-09-20",
        "-db", "${workspaceFolder}/data/reminder.db"
      ],
      "env": { "GOTOOLCHAIN": "local" }
    },
    {
      "name": "Debug 当前文件所在包的测试",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "env": { "GOTOOLCHAIN": "local" }
    },
    {
      "name": "Debug reminder.Evaluate 单测",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/internal/domain/reminder",
      "args": ["-test.run", "TestEvaluateDecisionBoundaries", "-test.v"],
      "env": { "GOTOOLCHAIN": "local" }
    }
  ]
}
