  "reason": "QA Owner 已授权所有待确认项默认按是处理，并按设计文档继续跑通后续测试设计流程；本批准仅适用于 pilot_test_design_only，不授予生产发布权限。",
  "test_rules": {
    "scope": {
      "unsupported_scenarios": [
        "custom_dimension",
        "result_set_filter",
        "multi_relation",
        "dynamic_relation"
      ],
      "exhaustive_for_this_change": true,
      "other_unsupported_scenarios": "preserve_existing_behavior"
    },
    "multiple_reasons": {
      "message_count": 1,
      "concatenate": false,
      "fixed_business_reason_priority": false,
      "selection": "return_the_single_valid_prompt_from_the_existing_execution_path",
      "permission_errors": "must_remain_first_and_must_not_be_replaced"
    },
    "metric_name": {
      "multiple_metrics": "use_the_first_triggering_metric_in_stable_filter_configuration_order",
      "resolution_order": [
        "non_empty_Filter.fieldName",
        "field_metadata_by_fieldId",
        "current_locale_dynamic_display_name"
      ],
      "unresolved_name": "fall_back_to_legacy_s307051518_without_an_empty_parameter"
    },
    "entry_consistency": {
      "required_entries": [
        "web_chart",
        "mobile_chart",
        "web_joined_table",
        "mobile_joined_table"
      ],
      "assertions": [
        "same_backend_reason",
        "same_error_code",
        "same_locale_message",
        "same_metric_parameter",
        "unsupported_detail_view_is_blocked"
      ],
      "implementation_evidence_required": true
    },
    "custom_dimension": {
      "covered_locations": [
        "dimension",
        "drill_field",
        "data_range"
      ],
      "preserve_existing_detection_order": true,
      "error_key": "CUSTOM_DIMENSION_DETAIL_REASON_UNSUPPORTED"
    },
    "dynamic_relation": {
      "scope": "all_what_and_what_list_dynamic_relations_without_ticket_theme_or_specific_object_restrictions",
      "error_key": "DYNAMIC_RELATION_METRIC_DETAIL_UNSUPPORTED",
      "replace_only_existing_object_relation_unsupported_failures": true
    },
    "multi_relation": {
      "error_key": "MULTI_RELATION_METRIC_DETAIL_UNSUPPORTED",
      "successful_existing_relation_resolution": "must_remain_successful",
      "replace_only_existing_object_relation_unsupported_failures": true
    },
    "permission": {
      "behavior": "preserve_existing_permission_and_data_visibility_checks",
      "priority": "before_business_unsupported_reason_mapping",
      "metric_name_visibility": "must_not_bypass_existing_permissions"
    },
    "compatibility": {
      "success_response": "unchanged",
      "failure_response_shape": "unchanged",
      "non_target_error_codes": "unchanged",
      "historical_charts_and_tables": "evaluate_in_place_without_migration",
      "distributed_reason_implementation": "accepted_conditionally",
      "unified_resolver_required_when": "cross_entry_consistency_or_exception_boundary_cannot_be_proven"
    },
    "localization": {
      "locale_source": "request_current_locale",
      "fallback": "platform_default_locale_then_legacy_error_behavior",
      "parameter_placeholder": "{0}",
      "parameter_transport": "BIBizException_errorCode_and_List_of_String",
      "errors": [
