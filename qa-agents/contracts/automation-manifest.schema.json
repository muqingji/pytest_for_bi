{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automation-manifest/1.0",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "generator_profile",
    "target_repository",
    "framework",
    "language",
    "case_mappings",
    "candidate_files",
    "execution",
    "permissions",
    "expected_artifacts"
  ],
  "properties": {
    "schema_version": {"const": "automation-manifest/1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "generator_profile": {"type": "string", "minLength": 1},
    "target_repository": {
      "type": "object",
      "required": ["repository_id", "access_class", "write_mode"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "access_class": {"const": "approved_automation_repository"},
        "write_mode": {"const": "artifact_only_candidate"}
      },
      "additionalProperties": false
    },
    "framework": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "case_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "expected_ids", "candidate_path"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "expected_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "candidate_path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "candidate_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content_hash"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "required": ["command", "timeout_seconds"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "required": ["business_repository_write", "network", "secrets"],
      "properties": {
        "business_repository_write": {"const": false},
        "network": {"type": "boolean"},
        "secrets": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
