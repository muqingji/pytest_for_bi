{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-agent-provider/1.0",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "entrypoint",
    "input_contract",
    "output_contract",
    "side_effects"
  ],
  "properties": {
    "schema_version": {"const": "qa-agent-provider/1.0"},
    "mode": {"const": "artifact_only"},
    "entrypoint": {"type": "string", "minLength": 1},
    "input_contract": {"const": "case-provider-input/1.0"},
    "output_contract": {"const": "case-provider-output/1.0"},
    "side_effects": {"type": "array", "maxItems": 0}
  },
  "additionalProperties": false
}
