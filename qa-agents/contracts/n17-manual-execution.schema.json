{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n17-manual-execution/1.0",
  "type": "object",
  "required": ["schema_version", "execution_plan_hash", "task_count", "completed_count", "pending_count", "tasks", "next_node"],
  "properties": {
    "schema_version": {"const": "n17-manual-execution/1.0"},
    "execution_plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "task_count": {"type": "integer", "minimum": 0},
    "completed_count": {"type": "integer", "minimum": 0},
    "pending_count": {"type": "integer", "minimum": 0},
    "tasks": {"type": "array"},
    "next_node": {"const": "N09"}
  },
  "additionalProperties": true
}
