{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-provider-input/1.0",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_run_id",
    "source_snapshot_id",
    "approved_scope",
    "test_strategy",
    "requirements",
    "source_refs",
    "input_hash"
  ],
  "properties": {
    "schema_version": {"const": "case-provider-input/1.0"},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "approved_scope": {"type": "object"},
    "test_strategy": {"type": "object"},
    "requirements": {"type": "array", "minItems": 1},
    "source_refs": {"type": "array", "minItems": 1},
    "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
