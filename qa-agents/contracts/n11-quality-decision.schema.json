{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n11-quality-decision/1.0",
  "type": "object",
  "required": ["schema_version", "policy_version", "policy_hash", "input_bindings", "decision", "release_disposition", "reasons", "warnings", "metrics", "next_node"],
  "properties": {
    "schema_version": {"const": "n11-quality-decision/1.0"},
    "policy_version": {"type": "string", "minLength": 1},
    "policy_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_bindings": {"type": "object"},
    "decision": {"enum": ["passed", "passed_with_warning", "blocked", "inconclusive"]},
    "release_disposition": {"enum": ["eligible", "pending"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "object"},
    "next_node": {"const": "N12"}
  },
  "additionalProperties": true
}
