{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment-observation/1.0",
  "title": "N07 Environment Observation",
  "description": "Observed environment state collected by a probe; N07 compares it against the frozen target.",
  "type": "object",
  "required": ["schema_version", "runtime"],
  "properties": {
    "schema_version": {"const": "environment-observation/1.0"},
    "environment": {"type": "string"},
    "requester_id": {"type": "string"},
    "deployment_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {"type": "string"},
          "commit": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "test_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {"type": "string"},
          "exists": {"type": "boolean"},
          "permissions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "feature_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flag": {"type": "string"},
          "value": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "tenant_configs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tenant": {"type": "string"},
          "language": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "test_data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {"type": "string"},
          "state": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "timezone": {"type": "string"},
        "language": {"type": "string"},
        "system_time_skew_seconds": {"type": "number"}
      },
      "additionalProperties": true
    },
    "test_namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {"type": "string"},
          "cleanup_policy": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "resource_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {"type": "string"},
          "acquired": {"type": "boolean"},
          "mode": {"enum": ["exclusive", "shared"]},
          "holder": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
