<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.qa.sync-eight-card</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-u</string>
    <string>__ROOT__/qa-agents/scripts/workflow_monitor.py</string>
    <string>--registry</string><string>__ROOT__/generated/active-workflows.json</string>
    <string>scan</string>
  </array>
  <key>StartInterval</key><integer>30</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/qa-sync-eight-card.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/qa-sync-eight-card.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>__ROOT__/qa-agents/src</string>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict></plist>
