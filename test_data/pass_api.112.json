      "priority": "P1",
      "req": {
        "body": {
          "language": "zh-CN"
        }
      },
      "resp": {
        "status_code": 200,
        "json_path": {
          "Result.FailureCode": 0
        }
      }
    },
    {
      "id": "switch_to_english",
      "name": "个人语言切换成英文",
      "priority": "P1",
      "req": {
        "body": {
          "language": "en"
        }
      },
      "resp": {
        "status_code": 200,
        "json_path": {
          "Result.FailureCode": 0
        }
      }
    }
  ]
}
