{
  "name": "hk",
  "http": {
    "base_url": "${HK_HTTP_BASE_URL}",
    "headers": {},
    "timeout": 20,
    "verify": true
  },
  "rpc": {
    "endpoint": "${HK_RPC_ENDPOINT}",
    "headers": {},
    "timeout": 20,
    "verify": true
  },
  "databases": {
    "mysql": {
      "engine": "mysql",
      "host": "${HK_MYSQL_HOST}",
      "port": "${HK_MYSQL_PORT:-3306}",
      "user": "${HK_MYSQL_USER}",
      "password": "${HK_MYSQL_PASSWORD}",
      "database": "${HK_MYSQL_DATABASE}",
      "charset": "utf8mb4"
    },
    "clickhouse": {
      "engine": "clickhouse",
      "host": "${HK_CH_HOST}",
      "port": "${HK_CH_PORT:-8123}",
      "username": "${HK_CH_USERNAME:-default}",
      "password": "${HK_CH_PASSWORD}",
      "database": "${HK_CH_DATABASE:-default}"
    }
  }
}
