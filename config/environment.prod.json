{
  "name": "prod",
  "http": {
    "base_url": "${PROD_HTTP_BASE_URL}",
    "headers": {},
    "timeout": 20,
    "verify": true
  },
  "rpc": {
    "endpoint": "${PROD_RPC_ENDPOINT}",
    "headers": {},
    "timeout": 20,
    "verify": true
  },
  "databases": {
    "mysql": {
      "engine": "mysql",
      "host": "${PROD_MYSQL_HOST}",
      "port": "${PROD_MYSQL_PORT:-3306}",
      "user": "${PROD_MYSQL_USER}",
      "password": "${PROD_MYSQL_PASSWORD}",
      "database": "${PROD_MYSQL_DATABASE}",
      "charset": "utf8mb4"
    },
    "clickhouse": {
      "engine": "clickhouse",
      "host": "${PROD_CH_HOST}",
      "port": "${PROD_CH_PORT:-8123}",
      "username": "${PROD_CH_USERNAME:-default}",
      "password": "${PROD_CH_PASSWORD}",
      "database": "${PROD_CH_DATABASE:-default}"
    }
  }
}
